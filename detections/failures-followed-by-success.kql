
let Lookback = 24h;
let CorrelationWindow = 10m;
let FailureThreshold = 5;
let FailedLogons =
    SecurityEvent
    | where TimeGenerated >= ago(Lookback)
    | where EventID == 4625
    | where isnotempty(IpAddress)
    | project
        IpAddress,
        FailureTime = TimeGenerated,
        FailedAccount = TargetAccount,
        FailureComputer = Computer;
let SuccessfulLogons =
    SecurityEvent
    | where TimeGenerated >= ago(Lookback)
    | where EventID == 4624
    | where isnotempty(IpAddress)
    | project
        IpAddress,
        SuccessTime = TimeGenerated,
        SuccessfulAccount = TargetAccount,
        SuccessComputer = Computer;
SuccessfulLogons
| join kind=inner FailedLogons on IpAddress
| where FailureTime < SuccessTime
| where FailureTime >= SuccessTime - CorrelationWindow
| summarize
    FailedAttempts = dcount(strcat(
        tostring(FailureTime), "|",
        FailedAccount, "|",
        FailureComputer
    )),
    TargetedAccounts = dcount(FailedAccount),
    FirstFailure = min(FailureTime),
    LastFailure = max(FailureTime)
    by IpAddress, SuccessTime, SuccessfulAccount, SuccessComputer
| where FailedAttempts >= FailureThreshold
| project
    IpAddress,
    SuccessfulAccount,
    SuccessComputer,
    FirstFailure,
    LastFailure,
    SuccessTime,
    FailedAttempts,
    TargetedAccounts
| order by SuccessTime desc
